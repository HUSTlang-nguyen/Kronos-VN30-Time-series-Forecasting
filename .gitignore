# Python
__pycache__/
*.py[cod]
.venv/
.venv-data/
venv/
.python-version
.pytest_cache/
.env
.env.*
!.env.example

# Disposable/local audit material
/tmp/

# Local model/runtime caches
.vendor/
.cache/

# Data bytes are managed by DVC; Git keeps pointers and receipts.
data/raw/
data/interim/
data/processed/
# SQLite runtime files are local; never share an active writer's journal
data/share/*-journal
data/share/*-wal
data/share/*-shm

# Large generated experiment outputs
artifacts/forecasts/
artifacts/scored/
artifacts/checkpoints/
artifacts/samples/
artifacts/cache/
artifacts/local/
reports/local/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
