# Python and local environments
__pycache__/
*.py[cod]
.venv/
.venv-data/
venv/
.python-version
.pytest_cache/
.env
.env.*
!.env.example

# Temporary output and model/runtime caches
/tmp/
.vendor/
.cache/
*.log
# Optimizer/RNG resume snapshots stay local; published weights use Git LFS.
artifacts/local/pc-rerun-*/**/last.pt
artifacts/local/pc-rerun-*/**/*-last.pt
artifacts/local/pc-rerun-*/**/*.tmp
artifacts/local/pc-rerun-*/**/*.progress.json

# DVC manages data bytes; Git keeps pointers and receipts.
data/raw/
data/interim/
data/processed/
data/share/*-journal
data/share/*-wal
data/share/*-shm

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
