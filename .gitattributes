# Preserve the original snapshot's hash-bound config and parser.
configs/data_source_acceptance.yaml -text
scripts/validate_vn30_sources.py -text
# Git stores portable DVC pointers and exact SHA256 receipts.
*.dvc text eol=lf
.dvc/.gitignore text eol=lf
.dvc/config text eol=lf
.dvcignore text eol=lf
data/share/*.sha256 -text
# Preserve artifact bytes for checkpoint hashes and experiment receipts.
artifacts/** -text whitespace=cr-at-eol
artifacts/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
artifacts/local/pc-rerun-*/**/*-best.pt filter=lfs diff=lfs merge=lfs -text
# Generated report hashes must survive Windows/Linux checkout.
docs/VN30_PC_Research_Report.md -text whitespace=cr-at-eol
experiments/verify_completed_candidate.py text eol=lf
experiments/finalize_pc_report.py text eol=lf
# Demo data hashes and pinned vendor source survive Windows/Linux checkouts.
demo/data/** -text whitespace=cr-at-eol
demo/registry.json -text whitespace=cr-at-eol
demo/vendor/kronos/** text eol=lf whitespace=-blank-at-eof,-blank-at-eol
# Preserve upstream license text verbatim, including its final blank line.
demo/licenses/** whitespace=-blank-at-eof
# Preserve standalone slide dependencies and manifest byte hashes across checkouts.
docs/slides/vendor/** -text whitespace=-blank-at-eof,-blank-at-eol
docs/slides/vn30-paper-ink.html -text whitespace=-blank-at-eof,-blank-at-eol
docs/slides/build_manifest.json -text whitespace=cr-at-eol
docs/slides/build_deck.py text eol=lf
docs/slides/check_deck.mjs text eol=lf
docs/slides/slide-outline.md text eol=lf
# LaTeX source/provenance hashes survive Windows/Linux checkout.
docs/latex/*.py text eol=lf
docs/latex/*.ps1 text eol=lf
docs/latex/*.tex text eol=lf
docs/latex/*.bib text eol=lf
docs/latex/*.md text eol=lf
docs/latex/*.json text eol=lf
docs/latex/tables/*.tex text eol=lf
docs/latex/**/*.pdf -text
docs/latex/*.zip -text
